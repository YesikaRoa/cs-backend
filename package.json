{
  "name": "cs-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "seed": "dotenv -e .env -- node prisma/seed.js",
    "postinstall": "node src/scripts/postinstall.js",
    "dev": "cross-env NODE_ENV=local nodemon src/index.js",
    "dev:remote": "cross-env NODE_ENV=development nodemon src/index.js",
    "start": "cross-env NODE_ENV=production node src/index.js",
    "migrate:dev": "cross-env NODE_ENV=development prisma migrate dev --skip-seed && npm run seed",
    "migrate:prod": "cross-env NODE_ENV=production prisma migrate deploy && npx prisma generate && npm run seed",
    "prisma:migrate:test": "dotenv -e .env.test -- npx prisma migrate deploy",
    "generate": "prisma generate",
    "test": "npm run prisma:migrate:test && jest --runInBand",
    "test:watch": "npm run prisma:migrate:test && jest --watch --runInBand",
    "test:cov": "npm run prisma:migrate:test && jest --coverage --runInBand"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^7.0.5",
    "pdfkit": "^0.17.1",
    "pg": "^8.14.1",
    "redis": "^5.6.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0",
    "zod": "^3.25.46"
  },
  "devDependencies": {
    "@babel/core": "^7.28.3",
    "@babel/preset-env": "^7.28.3",
    "@jest/globals": "^30.1.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "babel-jest": "^30.1.2",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "dotenv-cli": "^10.0.0",
    "jest": "^30.1.3",
    "nodemon": "^3.1.9",
    "prisma": "^6.6.0",
    "supertest": "^7.1.4"
  }
}
