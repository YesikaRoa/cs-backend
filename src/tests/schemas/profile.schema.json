{
  "getProfile": {
    "type": "object",
    "properties": {
      "first_name": { "type": "string" },
      "last_name": { "type": "string" },
      "email": { "type": "string", "format": "email" },
      "phone": { "type": ["string", "null"] },
      "url_image": { "type": ["string", "null"] },
      "dni": { "type": ["string", "null"] },
      "role": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" }
        },
        "required": ["id", "name"]
      },
      "community": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" }
        },
        "required": ["id", "name"]
      }
    },
    "required": ["first_name", "last_name", "email", "role", "community"]
  },
  "updateProfile": {
    "type": "object",
    "properties": {
      "first_name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50
      },
      "last_name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50
      },
      "email": {
        "type": "string",
        "format": "email"
      },
      "dni": {
        "type": "string",
        "maxLength": 20
      },
      "phone": {
        "type": "string",
        "maxLength": 20
      }
    },
    "additionalProperties": false
  },
  "updatePassword": {
    "title": "ChangePasswordPayload",
    "type": "object",
    "properties": {
      "currentPassword": {
        "type": "string",
        "minLength": 6
      },
      "newPassword": {
        "type": "string",
        "minLength": 6
      }
    },
    "required": ["currentPassword", "newPassword"],
    "additionalProperties": false
  }
}
